local function updateESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hl = plr.Character:FindFirstChild("AlessiumESP")
            if espEnabled then
                if not hl then
                    hl = Instance.new("Highlight")
                    hl.Name = "AlessiumESP"
                    hl.FillColor = Color3.fromRGB(255, 0, 180)
                    hl.OutlineColor = Color3.fromRGB(0, 255, 255)
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.Parent = plr.Character
                end
            else
                if hl then hl:Destroy() end
            end
        end
    end
end

local function getTargetHRP()
    if selectedTarget and selectedTarget.Character then
        return selectedTarget.Character:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

local function gotoPlayer()
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local tHrp = getTargetHRP()
    if myHrp and tHrp then
        myHrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, -3)
    end
end

local function bringPlayer()
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local tHrp = getTargetHRP()
    if myHrp and tHrp then
        tHrp.CFrame = myHrp.CFrame * CFrame.new(0, 0, 3)
    end
end

local function toggleFullbright()
