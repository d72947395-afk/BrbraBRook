local function freezeTarget()
    local tChar = selectedTarget and selectedTarget.Character
    if not tChar then return end
    local hum = tChar:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    local oldWalk = hum.WalkSpeed
    local oldJump = hum.JumpPower
    
    hum.WalkSpeed = 0
    hum.JumpPower = 0
    
    task.delay(3, function()
        if hum and hum.Parent then
            hum.WalkSpeed = oldWalk
            hum.JumpPower = oldJump
        end
    end)
end

local function toggleCarFly()
    carFlyEnabled = not carFlyEnabled
    if carFlyEnabled then
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local seat = hum and hum.SeatPart
        if not seat then
            carFlyEnabled = false
            return
        end
        local vehicle = seat.Parent
        local primary = vehicle.PrimaryPart or vehicle:FindFirstChildWhichIsA("BasePart")
        if not primary then carFlyEnabled = false return end

        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.P = 1250
        bv.Parent = primary
        local bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.P = 10000
        bg.D = 500
        bg.Parent = primary

        local function connectCar()
            return RunService.Heartbeat:Connect(function()
                if not carFlyEnabled then return end
                local c = LocalPlayer.Character
                if not c then return end
                local h = c:FindFirstChildOfClass("Humanoid")
                if not h or not h.SeatPart then return end
                local v = h.SeatPart.Parent
                if not v or not primary.Parent then return end

                local camera = workspace.CurrentCamera
                if not camera then return end

                local moveDir = Vector3.new(0, 0, 0)
                local pcMove = Vector3.new(0, 0, 0)

                if UserInputService:IsKeyDown(Enum.KeyCode.W) then pcMove = pcMove + camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then pcMove = pcMove - camera.CFrame.LookVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then pcMove = pcMove - camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then pcMove = pcMove + camera.CFrame.RightVector end
                if UserInputService:IsKeyDown(Enum.KeyCode.Space) then pcMove = pcMove + Vector3.new(0, 1, 0) end
                if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then pcMove = pcMove - Vector3.new(0, 1, 0) end

                bv.Velocity = pcMove.Magnitude > 0.1 and (pcMove.Unit * CONFIG.CAR_FLY.SPEED) or Vector3.new(0, 0, 0)
                bg.CFrame = camera.CFrame
            end)
        end
        carFlyConn = connectCar()
    else
        if carFlyConn then carFlyConn:Disconnect() carFlyConn = nil end
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum and hum.SeatPart then
                local primary = hum.SeatPart.Parent.PrimaryPart
                if primary then
                    for _, v in ipairs(primary:GetChildren()) do
                        if v:IsA("BodyVelocity") or v:IsA("BodyGyro") then
                            v:Destroy()
                        end
                    end
                end
            end
        end
    end
end

local function toggleAntiRagdoll()
    antiRagdollEnabled = not antiRagdollEnabled
    btnAntiRagdoll.Text = "Anti-Ragdoll: " .. (antiRagdollEnabled and "ON" or "OFF")
    btnAntiRagdoll.TextColor3 = antiRagdollEnabled and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(220, 220, 230)
    if antiRagdollEnabled then
        task.spawn(function()
            while antiRagdollEnabled do
                local char = LocalPlayer.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum:GetState() == Enum.HumanoidStateType.Physics then
                        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                    end
                end
                task.wait(0.1)
            end
        end)
    end
end

local function toggleAntiFling()
    antiFlingEnabled = not antiFlingEnabled
    btnAntiFling.Text = "Anti-Fling: " .. (antiFlingEnabled and "ON" or "OFF")
    btnAntiFling.TextColor3 = antiFlingEnabled and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(220, 220, 230)
    if antiFlingEnabled then
        antiFlingConn = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if not char then return end
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end
            if hrp.Velocity.Magnitude > 500 then
                hrp.Velocity = Vector3.new(0, 0, 0)
            end
        end)
    else
        if antiFlingConn then antiFlingConn:Disconnect() antiFlingConn = nil end
    end
end

