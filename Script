local function stopFly()
    flying = false
    if flyConnection then flyConnection:Disconnect() flyConnection = nil end
    if bodyVelocity then bodyVelocity:Destroy() bodyVelocity = nil end
    if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
    local char = LocalPlayer.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.PlatformStand = false end
    end
end

local function startFly()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    flying = true
    hum.PlatformStand = true

    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bodyVelocity.P        = 1250
    bodyVelocity.Parent   = hrp

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bodyGyro.P         = 10000
    bodyGyro.D         = 500
    bodyGyro.CFrame    = hrp.CFrame
    bodyGyro.Parent    = hrp

    flyConnection = RunService.RenderStepped:Connect(function()
        if not flying or not hrp or not bodyVelocity or not hum then return end
        if not hrp.Parent then return end
        local camera = workspace.CurrentCamera
        if not camera then return end

        local moveDir = Vector3.new(0, 0, 0)
        local pcMove  = Vector3.new(0, 0, 0)

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then pcMove = pcMove + camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then pcMove = pcMove - camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then pcMove = pcMove - camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then pcMove = pcMove + camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(CONFIG.FLY.PC_UP_KEY)   then pcMove = pcMove + Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(CONFIG.FLY.PC_DOWN_KEY) then pcMove = pcMove - Vector3.new(0, 1, 0) end

        if pcMove.Magnitude > 0.1 then
            moveDir = pcMove
        else
            local joyDir = hum.MoveDirection
            if joyDir.Magnitude > 0.1 then
                local camLookFlat = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
                local joyFlat     = Vector3.new(joyDir.X, 0, joyDir.Z)
                if camLookFlat.Magnitude > 0.01 and joyFlat.Magnitude > 0.01 then
                    if camLookFlat.Unit:Dot(joyFlat.Unit) > CONFIG.FLY.MOBILE_FORWARD_DOT then
                        moveDir = camera.CFrame.LookVector
                    end
                end
            end
        end

        bodyVelocity.Velocity = moveDir.Magnitude > 0.1
            and (moveDir.Unit * CONFIG.FLY.SPEED)
            or  Vector3.new(0, 0, 0)

        if CONFIG.FLY.TURN_CHARACTER then
            bodyGyro.CFrame = camera.CFrame
        end
    end)
end

local function enableNoclip()
    if noclipEnabled then return end
    noclipEnabled = true
    local char = LocalPlayer.Character
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
    if noclipConn then noclipConn:Disconnect() end
    noclipConn = RunService.Stepped:Connect(function()
        if not noclipEnabled then return end
        local c = LocalPlayer.Character
        if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
        end
    end)
end

local function disableNoclip()
    if not noclipEnabled then return end
    noclipEnabled = false
    if noclipConn then noclipConn:Disconnect() noclipConn = nil end
    if CONFIG.NOCLIP.RESTORE_ON_OFF then
        local char = LocalPlayer.Character
        if char then
            for _, p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = true end
            end
        end
    end
end

local function isDoor(obj)
    if not obj:IsA("BasePart") then return false end
    local n = string.lower(obj.Name)
    for _, kw in ipairs(CONFIG.ANTI_LOCK.DOOR_KEYWORDS) do
        if string.find(n, kw) then return true end
    end
    return false
end

local function enableAntiLock()
    if antiLockEnabled then return end
    antiLockEnabled = true
    table.clear(antiLockDoors)
    for _, obj in ipairs(workspace:GetDescendants()) do
        if isDoor(obj) then obj.CanCollide = false antiLockDoors[obj] = true end
    end
    antiLockConns[#antiLockConns + 1] = workspace.DescendantAdded:Connect(function(obj)
        if not antiLockEnabled then return end
        if isDoor(obj) then obj.CanCollide = false antiLockDoors[obj] = true end
    end)
end

local function disableAntiLock()
    if not antiLockEnabled then return end
    antiLockEnabled = false
    if CONFIG.ANTI_LOCK.RESTORE_ON_OFF then
        for obj, _ in pairs(antiLockDoors) do
            if obj and obj.Parent then obj.CanCollide = true end
        end
    end
    table.clear(antiLockDoors)
    for _, c in ipairs(antiLockConns) do c:Disconnect() end
    table.clear(antiLockConns)
end

