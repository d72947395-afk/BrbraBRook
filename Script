local function findSofa()
    local modelName = CONFIG.TROLL.SOFA_MODEL_NAME
    local baseName  = string.lower(CONFIG.TROLL.SOFA_BASE_NAME)
    local seatName  = string.lower(CONFIG.TROLL.SOFA_SEAT_NAME)
    local sofaModel = nil
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == modelName then sofaModel = obj break end
    end
    if not sofaModel then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and string.lower(obj.Name) == string.lower(modelName) then
                sofaModel = obj break
            end
        end
    end
    local basePart, seatPart = nil, nil
    if sofaModel then
        for _, obj in ipairs(sofaModel:GetDescendants()) do
            if obj:IsA("BasePart") then
                local n = string.lower(obj.Name)
                if not basePart and n == baseName then basePart = obj end
                if not seatPart and n == seatName then seatPart = obj end
            end
        end
    end
    return sofaModel, basePart, seatPart
end

local function fireSofaInteraction(basePart, seatPart, fallbackPos)
    local target = seatPart or basePart
    if not target and fallbackPos then
        local temp = Instance.new("Part")
        temp.Size = Vector3.new(1, 1, 1)
        temp.Position = fallbackPos
        temp.Anchored = true
        temp.CanCollide = false
        temp.Transparency = 1
        temp.Parent = workspace
        target = temp
        task.delay(2, function() if temp then temp:Destroy() end end)
    end
    if not target then return end
    local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
    if not prompt and target.Parent then
        prompt = target.Parent:FindFirstChildWhichIsA("ProximityPrompt", true)
    end
    if prompt then
        pcall(function()
            if fireproximityprompt then fireproximityprompt(prompt) else prompt:InputHoldBegin() task.wait(prompt.HoldDuration + 0.05) prompt:InputHoldEnd() end
        end)
        return
    end
    local cd = target:FindFirstChildWhichIsA("ClickDetector", true)
    if not cd and target.Parent then
        cd = target.Parent:FindFirstChildWhichIsA("ClickDetector", true)
    end
    if cd then
        pcall(function() if fireclickdetector then fireclickdetector(cd) else cd.MouseClick:Fire() end end)
    end
end

local function startAntiSit()
    if not CONFIG.TROLL.ANTI_SIT then return end
    if antiSitConn then antiSitConn:Disconnect() end
    local lastCheck = 0
    antiSitConn = RunService.Heartbeat:Connect(function()
        if not trolling then return end
        local now = tick()
        if now - lastCheck < CONFIG.TROLL.ANTI_SIT_INTERVAL then return end
        lastCheck = now
        local char = LocalPlayer.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        if hum.Sit then hum.Sit = false hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
        if hum:GetState() == Enum.HumanoidStateType.Seated then hum:ChangeState(Enum.HumanoidStateType.Running) end
    end)
end

local function stopAntiSit()
    if antiSitConn then antiSitConn:Disconnect() antiSitConn = nil end
end

local function stopTroll()
    trolling = false
    if trollConn then trollConn:Disconnect() trollConn = nil end
    if orbitBV then orbitBV:Destroy() orbitBV = nil end
    if endFlyBP then endFlyBP:Destroy() endFlyBP = nil end
    stopAntiSit()
    if btnTroll then
        btnTroll.Text       = "Troll: OFF"
        btnTroll.TextColor3 = Color3.fromRGB(220, 220, 230)
    end
end

local function doEndTeleport(hrp, target)
    local myHum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
    if myHum then myHum.Sit = false myHum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    endFlyBP = Instance.new("BodyPosition")
    endFlyBP.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    endFlyBP.P = 100000
    endFlyBP.D = 1000
    endFlyBP.Position = CONFIG.TROLL.END_TELEPORT_POS
    endFlyBP.Parent   = hrp
    task.wait(CONFIG.TROLL.END_TELEPORT_TIME)
    if endFlyBP then endFlyBP:Destroy() endFlyBP = nil end
    if CONFIG.TROLL.END_RETURN_TO_TARGET then
        local c = target and target.Character
        local cHrp = c and c:FindFirstChild("HumanoidRootPart")
        if cHrp then hrp.CFrame = CFrame.new(cHrp.Position + CONFIG.TROLL.LAND_OFFSET) end
    end
end

local function startTroll()
    if trolling then stopTroll() return end
    local target = selectedTarget
    if not target or not target.Character then
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local best, bestD = nil, CONFIG.TROLL.AUTO_TARGET_RADIUS
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local h = p.Character:FindFirstChild("HumanoidRootPart")
                if h then
                    local d = (h.Position - hrp.Position).Magnitude
                    if d < bestD then best, bestD = p, d end
                end
            end
        end
        target = best
    end
    if not target or not target.Character then return end

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    trolling = true
    if btnTroll then btnTroll.Text = "Troll: RUN" btnTroll.TextColor3 = Color3.fromRGB(255, 200, 0) end
    startAntiSit()

    task.spawn(function()
        local sofaModel, basePart, seatPart = findSofa()
        local teleportTarget
        if basePart then teleportTarget = basePart.Position
        elseif sofaModel then
            local pp = sofaModel.PrimaryPart or sofaModel:FindFirstChildWhichIsA("BasePart", true)
            if pp then teleportTarget = pp.Position end
        end
        if not teleportTarget then teleportTarget = CONFIG.TROLL.FALLBACK_POS end

        hrp.CFrame = CFrame.new(teleportTarget + CONFIG.TROLL.TELEPORT_OFFSET)
        task.wait(CONFIG.TROLL.STEP_DELAY)
        fireSofaInteraction(basePart, seatPart, teleportTarget)
        task.wait(CONFIG.TROLL.STEP_DELAY)

        local tChar = target.Character
        if not tChar then stopTroll() return end
        local tHrp = tChar:FindFirstChild("HumanoidRootPart")
        if not tHrp then stopTroll() return end

        orbitBV = Instance.new("BodyVelocity")
        orbitBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        orbitBV.P        = 5000
        orbitBV.Parent   = hrp
        local startTime = tick()

        trollConn = RunService.Heartbeat:Connect(function()
            if not trolling then return end
            if not hrp.Parent or not orbitBV or not orbitBV.Parent then
                if orbitBV then orbitBV:Destroy() orbitBV = nil end
                stopTroll()
                return
            end
            local c = target.Character
            if not c then
                if orbitBV then orbitBV:Destroy() orbitBV = nil end
                stopTroll()
                return
            end
            local cHrp = c:FindFirstChild("HumanoidRootPart")
            if not cHrp then
                if orbitBV then orbitBV:Destroy() orbitBV = nil end
                stopTroll()
                return
            end
            local angle = (tick() - startTime) * CONFIG.TROLL.SPIN_SPEED
            local orbitPos = cHrp.Position + Vector3.new(math.cos(angle), 0, math.sin(angle)) * CONFIG.TROLL.SPIN_RADIUS + Vector3.new(0, CONFIG.TROLL.SPIN_HEIGHT, 0)
            local delta = orbitPos - hrp.Position
            orbitBV.Velocity = delta * CONFIG.TROLL.ORBIT_PULL
            hrp.CFrame = CFrame.new(hrp.Position, cHrp.Position)
            local hum = c:FindFirstChildOfClass("Humanoid")
            if hum and hum.Sit then
                if trollConn then trollConn:Disconnect() trollConn = nil end
                if orbitBV then orbitBV:Destroy() orbitBV = nil end
                task.wait(0.15)
                fireSofaInteraction(basePart, seatPart, teleportTarget)
                task.wait(0.15)
                doEndTeleport(hrp, target)
                trolling = false
                stopAntiSit()
                if btnTroll then btnTroll.Text = "Troll: OFF" btnTroll.TextColor3 = Color3.fromRGB(220, 220, 230) end
            end
        end)

        local endT = tick() + CONFIG.TROLL.SIT_TIMEOUT
        while trolling and tick() < endT do task.wait(0.1) end
        if trolling then
            if trollConn then trollConn:Disconnect() trollConn = nil end
            if orbitBV then orbitBV:Destroy() orbitBV = nil end
            task.wait(0.15)
            fireSofaInteraction(basePart, seatPart, teleportTarget)
            task.wait(0.15)
            doEndTeleport(hrp, target)
            stopAntiSit()
            stopTroll()
        end
    end)
end

